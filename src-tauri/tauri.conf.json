{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Horizon Rust Clean",
  "version": "0.4.0",
  "identifier": "io.horizon.rustclean",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Horizon Rust Clean",
        "width": 1100,
        "height": 700,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
